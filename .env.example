# SEC EDGAR requires every requester to self-identify. Format: "Name email@example.com".
# See https://edgartools.readthedocs.io/en/stable/configuration/
EDGAR_IDENTITY="Your Name your.email@example.com"

# Telegram bot credentials. Create a bot via @BotFather to get the token,
# then message @userinfobot (or your bot) to get your numeric chat id.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=123456789

# Only alert on transactions valued at or above this many dollars.
MIN_TRANSACTION_VALUE=100000

# How many days back to scan on each run. 1 covers "since yesterday's run".
LOOKBACK_DAYS=1
